BOT_TOKEN=
OWNER_TELEGRAM_ID=
MUSIC_DB_PATH=data/music.db
# HTTPS URL of Mini App after configuring a reverse proxy and TLS
WEBAPP_URL=

# Optional. Exact HTTPS hostnames from trusted providers that allow direct MP3/M4A downloads.
# No wildcard or arbitrary hosts. Keep empty to disable importing external audio.
MUSIC_ALLOWED_MEDIA_HOSTS=

# Optional, off by default. Build with yt-dlp + FFmpeg (larger image).
MUSIC_WITH_YOUTUBE=false
MUSIC_ENABLE_YOUTUBE_SEARCH=false
# Requires search=true. Only import content you have permission to download.
MUSIC_ENABLE_YOUTUBE_DOWNLOAD=false

# Optional TMDB API Read Access Token for movie/TV metadata only.
# Keep private; never commit the real token. Empty disables TMDB search.
TMDB_READ_TOKEN=
